generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum TestimonialStatus {
  pending
  approved
  rejected
}

// What the public page leads with after the introduction (shared/src/lead-with.ts).
enum LeadWith {
  automatic
  experience
  work
  education
}

// Aurora's look: dark (the default) or light. The other themes have one look and ignore it.
enum PortfolioAppearance {
  dark
  light
}

// How testimonials are drawn on the Sidebar theme: a plain list (3 shown) or a carousel that never advances by itself.
enum TestimonialStyle {
  list
  carousel
}

enum LinkBioStyle {
  light
  soft
}

enum ContactMessageStatus {
  new
  read
  archived
}

enum AvailabilityStatus {
  open_to_work
  open_to_freelance
  open_to_collaborate
  custom
}

enum ReplyTime {
  same_day
  within_2_days
  within_a_week
}

enum PreferredContact {
  email
  linkedin
  phone
  any_visible_link
}

enum PostType {
  post
  link
}

enum PostStatus {
  draft
  published
}

enum LayoutMode {
  single
  multi
}

enum LinkType {
  linkedin
  github
  email
  phone
  website
  other
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  createdAt       DateTime  @default(now())
  // When they agreed to the Terms and Privacy Policy, and which version (shared/src/legal.ts).
  // Null for accounts made before consent was recorded.
  termsAcceptedAt DateTime?
  termsVersion    String?
  profile         Profile?
  aiUsage         AiUsage[]
}

model Profile {
  id                  String             @id @default(cuid())
  userId              String             @unique
  slug                String             @unique
  fullName            String
  tagline             String?
  about               String?
  location            String?
  avatarUrl           String?
  theme               String             @default("index")
  leadWith            LeadWith           @default(automatic)
  appearance          PortfolioAppearance @default(dark)
  testimonialStyle    TestimonialStyle   @default(list)
  accentColor         String             @default("#2563eb")
  published           Boolean            @default(false)
  // A made-up example profile (shared/src/samples.ts). Seeded without a usable login.
  isSample            Boolean            @default(false)
  // Whether the public page offers a PDF resume generated from it (/<slug>/resume.pdf).
  resumeEnabled       Boolean            @default(true)
  // The "Add to contacts" vCard of the public page (shared/src/contact-card.ts), and whether it holds the photo.
  contactCardEnabled  Boolean            @default(false)
  contactCardPhoto    Boolean            @default(false)
  // The language the profile is written in, and up to MAX_EXTRA_LANGUAGES more it is offered in
  // (shared/src/languages.ts). The words of the extra languages are in Translation.
  // The "Working together" card (shared/src/work-card.ts). Public only while workCardEnabled.
  workCardEnabled     Boolean            @default(false)
  timezone            String?
  workingHours        Json               @default("{\"mon\":[],\"tue\":[],\"wed\":[],\"thu\":[],\"fri\":[],\"sat\":[],\"sun\":[]}")
  replyTime           ReplyTime?
  preferredContact    PreferredContact?
  workNote            String?            @db.VarChar(140)
  // The suggested message of the Share menu (shared/src/share.ts); null uses the default.
  shareMessage        String?            @db.VarChar(200)
  // The contact form of the public page (shared/src/contact.ts). The intro is one plain line.
  contactFormEnabled  Boolean            @default(false)
  contactFormIntro    String?            @db.VarChar(140)
  // The link-in-bio card at /<slug>/links (shared/src/link-bio.ts): on or off, its look, and which
  // optional buttons it shows. Its custom buttons are the LinkBioLink rows.
  linkBioEnabled      Boolean            @default(false)
  linkBioStyle        LinkBioStyle       @default(light)
  linkBioShowContact  Boolean            @default(true)
  linkBioShowVcard    Boolean            @default(true)
  linkBioShowResume   Boolean            @default(true)
  linkBioShowShare    Boolean            @default(true)
  linkBioShowWork     Boolean            @default(true)
  // One long page, or a site of pages (shared/src/pages.ts). In multi mode pageConfig holds the pages:
  // which are shown, their names and order, and which sections each takes. Single mode ignores it, so
  // switching back and forth loses nothing.
  layoutMode          LayoutMode         @default(single)
  pageConfig          Json               @default("[]")
  // Whether the sitemap lists this profile's pages (search engines find them). Off until the owner opts in.
  sitemapListed       Boolean            @default(false)
  defaultLocale       String             @default("en")
  locales             String[]           @default([])
  // Whether visitors may submit testimonials (POST /public/:slug/testimonials).
  acceptTestimonials  Boolean            @default(false)
  // The availability badge on the public page (see shared/src/availability.ts).
  availabilityEnabled Boolean            @default(false)
  availabilityStatus  AvailabilityStatus @default(open_to_work)
  availabilityMessage String?            @db.VarChar(140)
  // Order, visibility and headings of the page sections (see shared/src/section-config.ts).
  // The default must match defaultSectionConfig(); existing rows get it when the column is added.
  sectionConfig       Json               @default("[{\"key\":\"about\",\"visible\":true},{\"key\":\"experience\",\"visible\":true},{\"key\":\"projects\",\"visible\":true},{\"key\":\"skills\",\"visible\":true},{\"key\":\"education\",\"visible\":true},{\"key\":\"writing\",\"visible\":false},{\"key\":\"testimonials\",\"visible\":false},{\"key\":\"contact\",\"visible\":false}]")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  links           Link[]
  skills          Skill[]
  experience      Experience[]
  projects        Project[]
  education       Education[]
  customSections  CustomSection[]
  customPages     CustomPage[]
  testimonials    Testimonial[]
  contactMessages ContactMessage[]
  linkBioLinks    LinkBioLink[]
  posts           Post[]
  translations    Translation[]
}

model Link {
  id        String   @id @default(cuid())
  profileId String
  type      LinkType
  url       String
  visible   Boolean  @default(true)
  order     Int      @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Skill {
  id        String @id @default(cuid())
  profileId String
  name      String
  order     Int    @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Experience {
  id          String    @id @default(cuid())
  profileId   String
  title       String
  company     String
  startDate   DateTime
  endDate     DateTime?
  description String
  order       Int       @default(0)

  profile  Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([profileId])
}

model Project {
  id          String   @id @default(cuid())
  profileId   String
  name        String
  // The project's address on the public page (/<slug>/work/<slug>). Made from the name when it is
  // created and never changed after, so a shared link keeps working when the project is renamed.
  slug        String
  url         String?
  description String
  techTags    String[]
  // Chosen by the owner to lead the public page (at most FEATURED_PROJECTS_MAX).
  featured    Boolean  @default(false)
  // The cover image (Cloudinary, only ever set by the upload endpoint) with its alt text and size.
  coverUrl    String?
  coverAlt    String?  @db.VarChar(140)
  coverWidth  Int?
  coverHeight Int?
  order       Int      @default(0)
  // The job this was built during ("Built while at {company}"). Cleared when that job is deleted.
  experienceId String?

  profile    Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  experience Experience?    @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  images     ProjectImage[]

  @@unique([profileId, slug])
  @@index([profileId])
  @@index([experienceId])
}

// A gallery image of a project (at most MAX_PROJECT_IMAGES). The file is in Cloudinary and the row is
// only ever made by the upload endpoint.
model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  url       String
  alt       String? @db.VarChar(140)
  width     Int
  height    Int
  order     Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Education {
  id          String    @id @default(cuid())
  profileId   String
  degree      String
  institution String
  startDate   DateTime
  endDate     DateTime?
  order       Int       @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

// A section the user made up (Certifications, Awards, ...). Its place on the page is held in
// Profile.sectionConfig under the key "custom:<id>"; `order` and `visible` mirror that entry
// and are kept in step with it by the service, so they can be read without parsing the JSON.
model CustomSection {
  id        String  @id @default(cuid())
  profileId String
  title     String
  order     Int     @default(0)
  visible   Boolean @default(true)

  profile Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  items   CustomSectionItem[]

  @@index([profileId])
}

model CustomSectionItem {
  id          String    @id @default(cuid())
  sectionId   String
  title       String
  subtitle    String?
  startDate   DateTime?
  endDate     DateTime?
  url         String?
  description String?
  order       Int       @default(0)

  section CustomSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

// An extra page of a multi-page portfolio ("Speaking", "Uses", "Press"), at /<slug>/p/<page slug>. Its
// text is plain text or limited Markdown; the sections on it are listed in Profile.pageConfig under
// the key "page:<id>". At most MAX_CUSTOM_PAGES per profile.
model CustomPage {
  id        String   @id @default(cuid())
  profileId String
  slug      String   @db.VarChar(30)
  title     String   @db.VarChar(30)
  body      String?
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, slug])
  @@index([profileId])
}

// A quote about the profile's owner, submitted by a visitor (pending until approved) or added by
// the owner (approved at once). `contactEmail` is for the owner and is never sent to visitors.
// `order` ranks the approved ones on the page.
model Testimonial {
  id            String            @id @default(cuid())
  profileId     String
  authorName    String
  authorRole    String?
  authorCompany String?
  message       String
  contactEmail  String?
  status        TestimonialStatus @default(pending)
  order         Int               @default(0)
  createdAt     DateTime          @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, status])
}

// A message a visitor sent through the contact form. Nothing is emailed: the owner reads it in the
// dashboard. `senderEmail` is for the owner only and is never sent to visitors. Messages are deleted
// after CONTACT_RETENTION_DAYS by a scheduled sweep (services/contact-retention.ts), and with the
// profile.
model ContactMessage {
  id          String               @id @default(cuid())
  profileId   String
  senderName  String               @db.VarChar(80)
  senderEmail String               @db.VarChar(254)
  subject     String?              @db.VarChar(120)
  message     String
  status      ContactMessageStatus @default(new)
  createdAt   DateTime             @default(now())
  readAt      DateTime?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, status, createdAt])
  @@index([createdAt])
}

// A custom button of the link-in-bio card. Its own table, like the profile's links and skills: the
// buttons are ordered, limited to LINK_BIO_MAX_BUTTONS, and their labels are translatable per
// language (Translation, entity "linkBioLink") while the address is shared by all languages.
model LinkBioLink {
  id        String @id @default(cuid())
  profileId String
  label     String @db.VarChar(40)
  url       String
  order     Int    @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

// A short post written here (Markdown body) or a link to an article elsewhere. Drafts are never
// public. The slug comes from the title, is unique within the profile, and stays when the title
// changes. The cover image lives in Cloudinary and is only ever set by the upload endpoint.
model Post {
  id            String     @id @default(cuid())
  profileId     String
  title         String     @db.VarChar(120)
  slug          String     @db.VarChar(80)
  type          PostType   @default(post)
  excerpt       String?    @db.VarChar(300)
  body          String?
  externalUrl   String?
  coverImageUrl String?
  status        PostStatus @default(draft)
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, slug])
  @@index([profileId, status, publishedAt])
  @@index([status, type, updatedAt, id])
}

enum TranslatableEntity {
  profile
  section
  experience
  education
  project
  skill
  customSection
  customItem
  post
  linkBioLink
  page
  customPage
  projectImage
}

// One owner-written text in one extra language. There is no foreign key to the thing translated
// (it spans several tables), so whoever deletes an experience, project, post and so on deletes its
// translations too (translation.service.ts). `entityId` is the row id; for the profile it is the
// profile id and for a built-in section heading it is the section key.
model Translation {
  id          String             @id @default(cuid())
  profileId   String
  locale      String
  entityType  TranslatableEntity
  entityId    String
  field       String
  value       String
  // Written by the AI suggestion and not yet edited or confirmed by the owner.
  needsReview Boolean            @default(false)
  updatedAt   DateTime           @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, locale, entityType, entityId, field])
}

// How many AI translation suggestions a user has asked for on a day (UTC), for the daily limit.
model AiUsage {
  userId String
  day    String
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}
